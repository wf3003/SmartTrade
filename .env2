# ═══════════════════════════════════════════════════════════════
#  QuantMax — AI 多交易所合约交易系统
#  唯一目标：交易利润最大化
#  使用前请填写下方各交易所 API 密钥
# ═══════════════════════════════════════════════════════════════



# ═══════════════════════════
#  一、交易所配置
# ═══════════════════════════

# 启用哪些交易所（逗号分隔）
# 可选: okx, gate, binance
EXCHANGES=okx

# ─── OKX ─── 这个是OKX子账户的
# OKX API 密钥（在 okx.com → API → 创建交割合约API）
OKX_API_KEY=eb58a65f-6a48-4dff-9312-e607d3557c57
OKX_API_SECRET=32D047B5BC64430DBBEEF5453AE4494F
OKX_API_PASSPHRASE=Aa1357913579~
# 启用模拟盘（建议先跑模拟盘测试）
# true  = 测试网（零风险，推荐首次使用）
# false = 实盘（真金白银，请先测试）
OKX_SANDBOX=true

# ─── Gate.io ───
# Gate.io API 密钥（在 gate.io → 账户 → API管理 → 创建API Key）
GATE_API_KEY=6f0a3fb4be6f57b1ecabf231999e3c83
GATE_API_SECRET=c82aba4b6c27f7164b8630bd7500c093686fd8b305835ee1e0dfe17d613e6dc1
GATE_SANDBOX=false

# ─── Binance ───
# 币安 API 密钥（在 binance.com → API管理 → 创建API Key）
BINANCE_API_KEY=JeLh76EgsG3NUxO8BtdLDPnR2XgJtucAAlP2XYvFxE6YONJbMYTr9Eqbp1Vmq2XQ
BINANCE_API_SECRET=GrtxYiNOgnmv9lfW4AMfQfu6OrpHDZwXRjpbXA3SmKJIigahX4QnJlvJqLyDAKIJ
# Binance 官方测试网: https://testnet.binancefuture.com/
BINANCE_SANDBOX=true



# ═══════════════════════════
#  二、AI 模型配置
# ═══════════════════════════

# API 密钥（在供应商官网获取）
AI_API_KEY=sk-071b81bc85564986bf50db83bc0bbb4c
# API 地址
# DeepSeek:   https://api.deepseek.com/v1
# OpenAI:     https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
AI_BASE_URL=https://api.deepseek.com/v1
# 模型名
# DeepSeek:   deepseek-v4-flash / deepseek-v4-pro
# OpenAI:     gpt-4o / o1-mini
# OpenRouter: 任意支持的模型
AI_MODEL=deepseek-v4-pro
# 创造性（0.0 = 保守稳定，1.0 = 自由激进）
# 交易推荐: 0.2 ~ 0.5
AI_TEMPERATURE=0.2
# AI 单次决策最大 token 数
AI_MAX_TOKENS=8000



# ═══════════════════════════
#  三、交易核心参数
# ═══════════════════════════

# 交易模式
# swap = 合约/U本位永续（推荐）
# spot = 现货
TRADE_MODE=swap

# 每笔开仓占可用资金百分比（行情好时满仓，差时自动缩到 60%/40%）
BASE_POSITION_PCT=20

# 默认杠杆倍数（AI 可在此之上灵活调整）
DEFAULT_LEVERAGE=6
# 允许的最大杠杆倍数
MAX_LEVERAGE=25

# 最大同时持仓数
MAX_POSITIONS=20
# 单笔持仓最长持有时间（小时，超时 AI 会被要求评估平仓）
MAX_HOLDING_HOURS=36

# 初始资金（仅用于计算盈亏比例，不影响实际交易）
INITIAL_BALANCE=5000

# 交易币种列表（逗号分隔，格式: BTC/USDT）
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,DOGE/USDT,BNB/USDT,SUI/USDT,LINK/USDT,AAVE/USDT,BCH/USDT



# ═══════════════════════════
#  四、风控设置
# ═══════════════════════════

# 账户止损线（总权益低于此值时，停止开新仓）
ACCOUNT_STOP_LOSS_USDT=500
# 账户止盈线（总权益达到此值时，停止开新仓，落袋为安）
ACCOUNT_TAKE_PROFIT_USDT=20000
# 最大回撤比例（账户总权益从峰值下跌 % 时，AI 被限制开新仓）
MAX_DRAWDOWN_PERCENT=50
# 单日最大亏损（当天累计亏损超过此值，暂停一切交易）
DAILY_LOSS_LIMIT_USDT=3000

# ─── 跟踪止盈（代码级自动保护） ───
# 价格涨 ≥0.8% 激活，四档阶梯回撤（0.8%/1.2%/2.0%/3.0%）



# ═══════════════════════════
#  五、服务配置
# ═══════════════════════════

# Web 仪表盘端口
# 注意：如果与 nof1.ai 或 crypto-trader 冲突，请改端口
PORT=3100
# 监听地址
# 0.0.0.0 = 允许局域网访问
# 127.0.0.1 = 仅本机访问
HOST=0.0.0.0



# ═══════════════════════════
#  六、数据与日志
# ═══════════════════════════

# SQLite 数据库路径（自动在 data/ 目录创建）
DATABASE_URL=file:./data/quantmax.db
# 日志级别: info / warn / error / debug
LOG_LEVEL=info


# ═══════════════════════════
#  七、代理设置（可选）
# ═══════════════════════════

# 通过 Clash / V2Ray 等代理访问交易所 API
HTTPS_PROXY=http://127.0.0.1:7890
